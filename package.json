{
  "name": "university-rank-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "npm run data:validate && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "data:export": "python3 scripts/export_sample.py",
    "data:validate": "node scripts/validate-data.mjs && node scripts/validate-catalog.mjs && node scripts/media-validate.mjs && python3 scripts/content_validate.py && node scripts/validate-simplified.mjs && node scripts/validate-supplements.mjs && python3 scripts/overview_validate.py",
    "data:catalog": "python3 scripts/export_catalog.py",
    "data:media": "node scripts/media-acquire.mjs --hero-limit 1000",
    "data:content": "python3 scripts/content_generate.py",
    "data:supplements": "python3 scripts/export_supplements.py",
    "data:polish": "python3 scripts/overview_polish.py",
    "data:population": "python3 scripts/population_backfill.py",
    "data:simplify": "python3 scripts/publish_simplified.py",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p '*_test.py'"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-slider": "^1.4.7",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-table": "^8.21.3",
    "astro": "7.3.2",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.17.1",
    "opencc-js": "^1.4.2",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0"
  }
}
